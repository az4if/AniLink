# Postgres connection string. Works unmodified against Supabase, Neon,
# a self-hosted box, or a local instance -- it's all just DATABASE_URL.
# Local example:      postgres://postgres:postgres@localhost:5432/anime_mapper
# Supabase example:   postgres://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# Neon example:       postgres://user:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anime_mapper

# Port the API listens on
PORT=3000

# Public URL of THIS deployment. Only used for the Render self-ping keep-alive
# (see src/helpers/self-poll.ts). Leave blank on localhost.
PUBLIC_URL=

# Set to "true" only when deployed on Render's free web service tier.
# Turns on the self-ping loop so the instance doesn't spin down after 15 min
# idle. Leave unset/false on localhost, a paid always-on instance, or any
# other host that doesn't sleep on inactivity.
RENDER_KEEP_ALIVE=false

# All source URLs below have working defaults baked into config.ts -- only
# set these if you want to point at a different mirror/fork.
# ANIME_LIST_MASTER_XML_URL=https://raw.githubusercontent.com/Anime-Lists/anime-lists/refs/heads/master/anime-list-master.xml
# FRIBB_JSON_URL=https://raw.githubusercontent.com/Fribb/anime-lists/refs/heads/master/anime-list-full.json
# ANIME_JSON_URL=https://raw.githubusercontent.com/anime-and-manga/lists/main/anime.json
# ANIME_AIRING_JSON_URL=https://raw.githubusercontent.com/anime-and-manga/lists/main/anime-airing.json
# Optional local cross-reference archive. Put ani.zip beside package.json or
# set an absolute path. Every original archive record is retained in DB.
# ANI_ZIP_PATH=./ani.zip

# TVDB v4 API -- register a project key at thetvdb.com/api-information
TVDB_API_KEY=
TVDB_API_PIN=
# Base URL for the TVDB v4 API itself -- NOT the same thing as the key
# above. Only set this if you need to point at something other than the
# real API (e.g. a mock server in tests).
TVDB_API_URL=https://api4.thetvdb.com/v4

# TMDB v4 Read Access Token. TMDB is indexed for every mapped title so its
# artwork is preserved even when TVDB exists; it becomes the metadata and
# episode fallback when no TVDB ID is mapped.
TMDB_API_KEY=
TMDB_API_URL=https://api.themoviedb.org/3
TMDB_IMAGE_URL=https://image.tmdb.org/t/p

# Delay (seconds) after each single per-id "ask -> get -> index" step
# before moving to the next id -- id 1 ask/get/index, wait INDEX_DELAY,
# id 2 ask/get/index, wait INDEX_DELAY, and so on. Applies to TVDB, TMDB,
# and remote ani.zip per-title indexing, plus each 500-record local import batch.
INDEX_DELAY=5

# Remote ani.zip enrichment: multilingual titles, provider-ID gap fills,
# direct episode mappings, episode metadata, and artwork. No API key needed.
ANI_ZIP_API_URL=https://api.ani.zip

# In-process scheduler (see README "Scheduling" section). Off by default --
# an external pinger hitting POST /indexer/* on a schedule is more reliable
# on a host that sleeps when idle. Turn this on for an always-on host.
ENABLE_SCHEDULER=false

# XML + Fribb + lists-main ids + lists-main airing, refreshed together
MAPPING_SYNC_HOURS=3

# TVDB: only new + currently-airing tvdb_ids (naturally == everything on
# the very first run, since nothing's cached yet -- see tvdb-targets.ts)
TVDB_SYNC_HOURS=6

# TVDB: full resync of every mapped tvdb_id regardless of cache state
TVDB_FULL_SYNC_HOURS=720

TMDB_SYNC_HOURS=6
TMDB_FULL_SYNC_HOURS=720

ANI_ZIP_SYNC_HOURS=12
ANI_ZIP_FULL_SYNC_HOURS=720

# Shared secret required on POST /indexer/* routes so randoms on the internet
# can't kick off a scrape against your AniDB/TVDB quota. Left unset or
# empty, these routes are OPEN -- no key required. Set a real value before
# deploying publicly.
ADMIN_KEY=

# CORS. "*" (default) allows any origin -- fine for a public read API.
# Set a comma-separated allow-list to restrict browser access instead:
# CORS_ORIGIN=https://domainone.com,https://domaintwo.com
CORS_ORIGIN=*

# Per-IP rate limit, applied to every route. 0 = unlimited.
RATE_LIMIT=100

# Window the RATE_LIMIT count above applies to, in seconds.
RATE_LIMIT_WINDOW_SEC=60
