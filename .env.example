# Postgres connection string. Works unmodified against Supabase, Neon,
# a self-hosted box, or a local instance -- it's all just DATABASE_URL.
# Local example:      postgres://postgres:postgres@localhost:5432/anime_mapper
# Supabase example:   postgres://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# Neon example:       postgres://user:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anime_mapper

# Port the API listens on
PORT=3000

# Public URL of THIS deployment. Only used for the Render self-ping keep-alive
# (see src/helpers/self-poll.ts). Leave blank on localhost.
PUBLIC_URL=

# Set to "true" only when deployed on Render's free web service tier.
# Turns on the self-ping loop so the instance doesn't spin down after 15 min
# idle. Leave unset/false on localhost, a paid always-on instance, or any
# other host that doesn't sleep on inactivity.
RENDER_KEEP_ALIVE=false

# All source URLs below have working defaults baked into config.ts -- only
# set these if you want to point at a different mirror/fork.
# ANIME_LIST_MASTER_XML_URL=https://raw.githubusercontent.com/Anime-Lists/anime-lists/refs/heads/master/anime-list-master.xml
# FRIBB_JSON_URL=https://raw.githubusercontent.com/az4if/anime-lists-fribb/refs/heads/master/anime-list-full.json
# ANIME_JSON_URL=https://raw.githubusercontent.com/anime-and-manga/lists/main/anime.json
# ANIME_AIRING_JSON_URL=https://raw.githubusercontent.com/anime-and-manga/lists/main/anime-airing.json

# TVDB v4 API -- register a project key at thetvdb.com/api-information
TVDB_API_KEY=
TVDB_API_PIN=

# Shared secret required on POST /indexer/* routes so randoms on the internet
# can't kick off a scrape against your AniDB/TVDB quota.
ADMIN_KEY=change-me
