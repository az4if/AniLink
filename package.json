{
  "name": "anilink",
  "version": "0.1.0",
  "description": "AniLink -- AniDB <-> TVDB/TMDB/AniList/MAL episode mapping API. Mirrors AniDB's full catalog, keyed off community mapping data, enriched with TVDB episode data.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "ingest:mapping": "tsx src/mapping/ingest.ts",
    "ingest:ani-zip": "tsx src/mapping/ani-zip.ts",
    "ingest:fribb": "tsx src/mapping/fribb.ts",
    "ingest:lists": "tsx src/mapping/lists.ts",
    "test": "tsx test/resolver.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "adm-zip": "^0.5.18",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.36.0",
    "fast-xml-parser": "^4.5.0",
    "hono": "^4.6.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
